{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "le-sillage-auto-reject-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  // No fetch handler and no HTTP route — this Worker only responds to its
  // cron trigger, so it doesn't need a workers.dev subdomain either.
  "workers_dev": false,
  // Vercel Hobby caps cron jobs at once per day (see vercel.json — every job
  // there is staggered to a different hour for exactly that reason). This
  // Worker hits every /api/cron route every 15 minutes (the JOBS list in
  // src/index.ts), so an unpaid order nobody reopens releases its hold
  // within about 15 minutes of the hour. vercel.json's daily entries stay
  // as the fallback.
  // Cloudflare's free Cron Triggers have no such cap. The name is from when
  // auto-reject was its only job — changing it deploys a second Worker.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
