# Le Sillage — example environment file
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
# Get this from your Neon project: https://neon.tech
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-32-byte-random-base64url-value
AUTH_URL=http://localhost:3000

# --- Google OAuth (for customer sign-in) ---
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: ${APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (for customer sign-in) ---
# Create at https://developers.facebook.com/apps/
# Redirect URI: ${APP_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Admin ---
# Minimum 12 characters. Used for the /admin sign-in.
ADMIN_PASSWORD=replace-me-with-a-strong-password

# --- Email (Nodemailer / Gmail) ---
# Generate a new App Password at https://myaccount.google.com/apppasswords
# Do NOT reuse the original credential — it has been revoked.
GMAIL_USER=le.sillage.mnl@gmail.com
GMAIL_APP_PASSWORD=replace-me-with-new-app-password
ADMIN_EMAIL=le.sillage.mnl@gmail.com

# --- Vercel Blob (optional for local dev) ---
# Without this, local uploads fall back to a local file-based store under .blob/
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=

# --- Storefront contact (optional) ---
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_PICKUP_NOTES=Pickup location and hours TBD. Please wait for confirmation.