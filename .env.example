# Le Sillage — example environment file
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3030
APP_PORT=3030
APP_URL=http://localhost:3030

# --- Database (Supabase Postgres) ---
# Project: Settings → Database → Connection string (Transaction pooler, port 6543 for runtime).
# Rotate the password at https://supabase.com/dashboard before first use.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase clients (used for Storage signed URLs) ---
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-32-byte-random-base64url-value
AUTH_URL=http://localhost:3030

# --- Google OAuth (for customer sign-in) ---
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: ${APP_URL}/api/auth/callback/google (e.g. http://localhost:3030/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (for customer sign-in) ---
# Create at https://developers.facebook.com/apps/
# Valid OAuth redirect URI: ${APP_URL}/api/auth/callback/facebook (e.g. http://localhost:3030/api/auth/callback/facebook)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Admin ---
# Minimum 6 characters, must include at least one digit.
# Admin promotion is by email through OAuth sign-in; this value is retained for env validation only.
ADMIN_PASSWORD=admin1234

# --- Email (Nodemailer / Gmail) ---
# Rotate at https://myaccount.google.com/apppasswords after the first successful send.
GMAIL_USER=le.sillage.mnl@gmail.com
GMAIL_APP_PASSWORD=replace-me-with-new-app-password
ADMIN_EMAIL=le.sillage.mnl@gmail.com

# --- Vercel Blob (optional for local dev) ---
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=

# --- Storefront contact (optional) ---
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_PICKUP_NOTES=Pickup location and hours TBD. Please wait for confirmation.
