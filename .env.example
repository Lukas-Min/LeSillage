# Le Sillage Manila — example environment file
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Whatever DATABASE_URL you put there is the database every local script
# (db:migrate, db:seed, one-off scripts) writes to — if it's production, so is
# every local test. Point it at a separate database for experiments.

# --- Application ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3030
APP_PORT=3030
APP_URL=http://localhost:3030
# On Vercel, set APP_URL, AUTH_URL, and NEXT_PUBLIC_APP_URL to the production origin
# (https://lesillagemanila.com). Keep localhost values in .env.local for `npm run dev`.

# --- Database (Supabase Postgres) ---
# Project: Settings → Database → Connection string (Transaction pooler, port 6543 for runtime).
# Rotate the password at https://supabase.com/dashboard before first use.
DATABASE_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_DIRECT_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase clients (optional; nothing reads these today — receipts live in
# the private Vercel Blob store below) ---
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth.js ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-32-byte-random-base64url-value
AUTH_URL=http://localhost:3030

# --- Google OAuth (for customer sign-in) ---
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: ${APP_URL}/api/auth/callback/google (e.g. http://localhost:3030/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (currently switched off) ---
# The Facebook button stays hidden even when these are set — see
# configuredOAuthProviders in src/lib/oauth-providers.ts.
# Create at https://developers.facebook.com/apps/
# Valid OAuth redirect URI: ${APP_URL}/api/auth/callback/facebook (e.g. http://localhost:3030/api/auth/callback/facebook)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Admin ---
# Minimum 6 characters, must include at least one digit.
# `npm run db:set-admin-password` sets this as the ADMIN_EMAIL account's
# password login. Admin role itself comes from an exact ADMIN_EMAIL match on
# sign-in (Google or password), so ADMIN_EMAIL must be the real address.
ADMIN_PASSWORD=admin1234

# --- Email (Nodemailer / Gmail) ---
# Rotate at https://myaccount.google.com/apppasswords after the first successful send.
GMAIL_USER=lesillagemanila@gmail.com
GMAIL_APP_PASSWORD=replace-me-with-new-app-password
ADMIN_EMAIL=lesillagemanila@gmail.com

# --- Vercel Blob (optional for local dev) ---
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=
# Separate private-access store for payment receipts — the store above only
# supports public access. Without this set, uploadPrivateImage falls back to
# local disk in dev, or throws a clear error on Vercel.
RECEIPTS_READ_WRITE_TOKEN=

# --- Storefront contact (optional) ---
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_PICKUP_NOTES=North Signal Village, Taguig City · Open 8:00 AM to 10:00 PM daily

# --- Cron ---
# Guards all five /api/cron/* routes — in production a missing secret rejects
# every cron call. Callers send `Authorization: Bearer $CRON_SECRET`: the
# Cloudflare Worker in workers/auto-reject-cron (runs every route hourly), and
# Vercel Cron (vercel.json, each route once a day as a fallback). The Worker needs
# the SAME value set with `wrangler secret put CRON_SECRET`. Nothing keeps the two
# in sync — change one, change both. The local `npm run <job>` scripts don't need it.
CRON_SECRET=
